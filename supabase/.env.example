# Copy to supabase/.env and fill in once the Supabase project exists.
# Never commit the real file — it's in .gitignore.

# --- Project (from Supabase dashboard > Project Settings > API) ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Dashboard > Developers > API keys / Webhooks) ---------------
# Use the club's existing WooCommerce/Stripe account if it can be reused —
# see docs/OPEN_QUESTIONS.md. Apply for the nonprofit rate at the same time.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Ticket / membership signing keys (briefing §13.3-13.4) ---------------
# 32 random bytes each, base64. Generate with:
#   openssl rand -base64 32
# Store the real values in Supabase Vault, not here, once deployed — this
# file is for local `supabase functions serve` only.
MASTER_TICKET_KEY=
MASTER_MEMBER_KEY=

# --- Eventbrite (organiser ID 29840816681) --------------------------------
EVENTBRITE_API_TOKEN=
EVENTBRITE_ORGANIZATION_ID=29840816681

# --- WordPress -------------------------------------------------------------
WORDPRESS_BASE_URL=https://www.frontlineclub.com

# --- Podcast RSS (Spotify for Creators show settings, [CONFIRM] the URL) --
PODCAST_RSS_URL=

# --- Firebase Cloud Messaging (server key for push) -----------------------
FCM_SERVICE_ACCOUNT_JSON=
