# Generated localization
**/lib/l10n/generated/

# pubspec.lock is committed for the two apps (app/, admin/) per Flutter's
# own recommendation for reproducible builds, but not for the flc_core
# package — packages shouldn't pin their consumers' resolutions.
packages/*/pubspec.lock

# IDE
.idea/
.vscode/
*.iml

# Claude Code session state (not project content)
.claude/

# Secrets / env
.env
.env.*
!.env.example
supabase/.env
supabase/.temp/
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart
*.jks
*.keystore

# OS
.DS_Store
Thumbs.db

# Node (WordPress plugin tooling, admin build tools if any)
node_modules/

